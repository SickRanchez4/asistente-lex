# Ejecución directa del gateway. Copia este archivo como .env en esta carpeta.
PORT=4000
# true en HTTPS; false solo en HTTP local.
COOKIE_SECURE=false
MS01_URL=http://localhost:8081
MS02_URL=http://localhost:8082
MS03_URL=http://localhost:8083
MS04_URL=http://localhost:8084
SERVICE_TIMEOUT_MS=3000
CORS_ORIGINS=http://localhost:9000,http://localhost:9100,http://localhost:9200

# Plazos de las llamadas REST (spec 002): ordinaria, presupuesto total IA y por archivo.
REST_TIMEOUT_MS=10000
AI_BUDGET_MS=60000
FILE_TRANSFER_TIMEOUT_MS=60000
# Cuerpo GraphQL máximo: Base64 de 10 MiB más margen para JSON.
MAX_REQUEST_BODY_BYTES=14680064

# Mismos valores que en el .env de la raiz. Genera cada uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
USER_CONTEXT_SIGNING_KEY=
MS01_API_TOKEN=
MS02_API_TOKEN=
MS03_API_TOKEN=
MS04_API_TOKEN=
