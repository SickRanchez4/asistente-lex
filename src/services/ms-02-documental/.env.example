# Ejecución directa de MS-02. Copia este archivo como .env en esta carpeta.
# Usa la misma conexion externa que en el .env de la raiz.
DB_HOST=
DB_PORT=5432
DB_NAME=asistente_lex
DB_USER=asistente_lex
DB_PASSWORD=
DB_SCHEMA=documental
DB_SSLMODE=verify-full
# Ruta absoluta en tu maquina, no /certs (esa ruta solo existe en Docker).
DB_SSLROOTCERT=
# Carpeta local que emula el almacenamiento de archivos (excluida de git).
FILE_STORAGE_PATH=../../../.data/ms-02-files
HEALTH_CHECK_TIMEOUT_MS=2000
# Mismos valores que MS02_INTERNAL_API_TOKEN y USER_CONTEXT_SIGNING_KEY del .env de la raiz.
INTERNAL_API_TOKEN=
USER_CONTEXT_SIGNING_KEY=
# MS-01 valida identidad vigente, pertenencia y estado; mismo MS01_INTERNAL_API_TOKEN de la raiz.
MS01_URL=http://localhost:8081
MS01_API_TOKEN=
FILE_TRANSFER_TIMEOUT_MS=60000
MS04_URL=http://localhost:8084
MS04_API_TOKEN=
AI_BUDGET_MS=60000
