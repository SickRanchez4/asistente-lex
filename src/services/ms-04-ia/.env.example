# Ejecución directa de MS-04. Copia este archivo como .env en esta carpeta.
# URI del proveedor, con credenciales y opciones de autenticacion/TLS.
MONGO_URI=
MONGO_DB=ia
HEALTH_CHECK_TIMEOUT_MS=2000
# Mismos valores que MS04_INTERNAL_API_TOKEN y USER_CONTEXT_SIGNING_KEY del .env de la raiz.
INTERNAL_API_TOKEN=
USER_CONTEXT_SIGNING_KEY=
MS01_URL=http://localhost:8081
MS04_AUDIT_API_TOKEN=
# Obligatorio solo para preparacion explicita; nunca se usa como sustituto de un modelo editado.
AGENT_INITIAL_MODEL=
AGENTS_PREPARE=false
OPENAI_API_KEY=
