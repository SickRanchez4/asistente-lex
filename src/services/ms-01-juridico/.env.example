# Ejecución directa de MS-01. Copia este archivo como .env en esta carpeta.
# Usa la misma conexion externa que en el .env de la raiz.
PORT=8081
DB_HOST=
DB_PORT=5432
DB_NAME=asistente_lex
DB_USER=asistente_lex
DB_PASSWORD=
DB_SCHEMA=juridico
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSLMODE=verify-full
# Ruta absoluta en tu maquina, no /certs (esa ruta solo existe en Docker).
DB_SSLROOTCERT=
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_ACCESS_KEY_ID=local
DYNAMODB_SECRET_ACCESS_KEY=local
HEALTH_CHECK_TIMEOUT_MS=2000
# Mismos valores que MS01_INTERNAL_API_TOKEN y USER_CONTEXT_SIGNING_KEY del .env de la raiz.
INTERNAL_API_TOKEN=
MS04_AUDIT_API_TOKEN=
USER_CONTEXT_SIGNING_KEY=
APP_ENV=local
AUTH_PREPARE=false
# AUTH_DEMO=true prepara Admin y Abogado locales; no restablece cuentas existentes.
AUTH_DEMO=false
AUTH_DEMO_EMAIL=admin@demo.com
AUTH_DEMO_PASSWORD=password
AUDIT_TABLE=lex-access-events-v1
