# Ejecución directa de MS-03. Copia este archivo como .env en esta carpeta.
# Usa la misma conexion externa que en el .env de la raiz.
APP_NAME=ms-03-erp
APP_ENV=local
APP_DEBUG=false
LOG_CHANNEL=stderr
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

DB_HOST=
DB_PORT=5432
DB_NAME=asistente_lex
DB_USER=asistente_lex
DB_PASSWORD=
DB_SCHEMA=erp
DB_SSLMODE=verify-full
# Ruta absoluta en tu maquina, no /certs (esa ruta solo existe en Docker).
DB_SSLROOTCERT=
HEALTH_CHECK_TIMEOUT_MS=2000
