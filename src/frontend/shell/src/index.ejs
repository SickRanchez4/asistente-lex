<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Asistente Lex</title>
    <link rel="stylesheet" href="/styles/ui.css" />
    <script type="systemjs-importmap">
      {
        "imports": {
          "@asistente-lex/abogado": "<%= abogadoUrl %>",
          "@asistente-lex/admin": "<%= adminUrl %>"
        }
      }
    </script>
    <script src="/libs/system.min.js"></script>
    <script src="/libs/amd.min.js"></script>
  </head>
  <body>
    <a id="al-skip-link" class="al-skip-link" href="#al-inicio">Saltar al contenido</a>
    <header class="al-header">
      <div class="al-header-inner">
        <a class="al-brand" href="/" data-al-navigation>
          <img src="/static/lex-ai-logo.png" alt="Lex AI" width="80" height="80" />
          <span>Asistente Lex</span>
        </a>
        <nav id="al-session-nav" class="al-nav" aria-label="Cuenta" hidden>
          <a id="al-workspace" href="/" data-al-navigation>Mi espacio</a>
          <a href="/cuenta" data-al-navigation>Contraseña</a>
          <button id="al-logout" class="al-button al-button--secondary" type="button">Cerrar sesión</button>
        </nav>
      </div>
    </header>
    <aside id="al-public-settings" class="al-page" aria-label="Avisos y ayuda" hidden>
      <p id="al-global-message" class="al-notice" role="status" hidden></p>
      <a id="al-support-contact" hidden></a>
      <p id="al-public-settings-error" class="al-muted" role="status" hidden>No se pudieron consultar los avisos y el contacto de soporte.</p>
    </aside>
    <main id="al-inicio" class="al-page" tabindex="-1">
      <div id="al-session-pending" role="status">Verificando sesión...</div>
      <form id="al-login-form" class="al-auth-form" hidden>
        <h1>Iniciar sesión</h1>
        <div class="al-field"><label for="al-email">Correo electrónico</label><input id="al-email" name="email" class="al-input" type="email" autocomplete="username" maxlength="254" required /></div>
        <div class="al-field"><label for="al-password">Contraseña</label><input id="al-password" name="password" class="al-input" type="password" autocomplete="current-password" required /></div>
        <button class="al-button" type="submit">Entrar</button>
      </form>
      <button id="al-session-retry" class="al-button" type="button" hidden>Reintentar</button>
    </main>
    <div id="al-auth-message" class="al-page" role="status" aria-live="polite" hidden></div>
    <main id="al-account" class="al-page" tabindex="-1" hidden>
      <form id="al-password-form" class="al-auth-form">
        <h1>Cambiar contraseña</h1>
        <div class="al-field"><label for="al-current-password">Contraseña actual</label><input id="al-current-password" name="currentPassword" class="al-input" type="password" autocomplete="current-password" required /></div>
        <div class="al-field"><label for="al-new-password">Nueva contraseña</label><input id="al-new-password" name="newPassword" class="al-input" type="password" autocomplete="new-password" required /></div>
        <div class="al-field"><label for="al-confirm-password">Repetir nueva contraseña</label><input id="al-confirm-password" name="confirmPassword" class="al-input" type="password" autocomplete="new-password" required /></div>
        <button class="al-button" type="submit">Guardar contraseña</button>
      </form>
    </main>
    <section id="al-route-error" class="al-page" role="alert" tabindex="-1" hidden>
      <div class="al-status" data-kind="not-found">
        <h2>Página no disponible</h2>
        <p>La dirección no corresponde a una vista de la plataforma.</p>
        <a href="/" data-al-navigation>Volver al inicio</a>
      </div>
    </section>
    <section id="al-mount-error" class="al-page" role="alert" tabindex="-1" hidden>
      <div class="al-status" data-kind="unavailable">
        <h2>No se pudo mostrar la aplicación</h2>
        <p>La vista no está disponible. Vuelve al inicio o recarga para intentarlo nuevamente.</p>
        <a href="/" data-al-navigation>Volver al inicio</a>
      </div>
    </section>
  </body>
</html>
