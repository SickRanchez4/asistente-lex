# Configuracion de la app. Completa las conexiones antes de iniciar Docker.
# No incluyas credenciales de administrador.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=asistente_lex
POSTGRES_USER=asistente_lex
POSTGRES_PASSWORD=
# verify-full verifica el certificado y el nombre del servidor.
# Coloca la CA del proveedor en infra\certificates\postgresql-ca.crt.
# disable solo para un servidor de desarrollo local sin TLS.
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/certs/postgresql-ca.crt
MS01_DB_CONNECTION_TIMEOUT_MS=10000

# URI completa, con usuario, password, authSource y opciones TLS del proveedor.
# Codifica los caracteres especiales del usuario/password para una URI.
# Si contiene $, usa comillas simples para evitar interpolacion de Compose.
MONGO_URI=
MONGO_DB=ia
AGENT_INITIAL_MODEL=gpt-4o-mini
OPENAI_API_KEY=

DYNAMODB_REGION=us-east-1
APP_ENV=local
AUTH_AUDIT_TABLE=lex-access-events-v1
# true al servir el Shell por HTTPS; false solo para HTTP local.
COOKIE_SECURE=false
MS01_DYNAMODB_ACCESS_KEY_ID=local
MS01_DYNAMODB_SECRET_ACCESS_KEY=local

HEALTH_CHECK_TIMEOUT_MS=2000
GATEWAY_SERVICE_TIMEOUT_MS=3000
GATEWAY_REST_TIMEOUT_MS=10000
GATEWAY_AI_BUDGET_MS=60000
GATEWAY_FILE_TRANSFER_TIMEOUT_MS=60000
GATEWAY_MAX_REQUEST_BODY_BYTES=14680064
GATEWAY_CORS_ORIGINS=http://localhost:9000,http://localhost:9100,http://localhost:9200
GATEWAY_MS01_URL=http://ms-01-juridico:8081
GATEWAY_MS02_URL=http://ms-02-documental:8082
GATEWAY_MS03_URL=http://ms-03-erp:8083
GATEWAY_MS04_URL=http://ms-04-ia:8084

# Autenticacion REST interna (spec 002). Solo para el entorno local, no para produccion.
# Genera cada valor con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Clave compartida para firmar/verificar el contexto de usuario (minimo 32 caracteres).
USER_CONTEXT_SIGNING_KEY=
# Credencial propia de cada servicio receptor.
MS01_INTERNAL_API_TOKEN=
MS02_INTERNAL_API_TOKEN=
MS03_INTERNAL_API_TOKEN=
MS04_INTERNAL_API_TOKEN=
MS04_AUDIT_API_TOKEN=

SHELL_PORT=9000
ABOGADO_PORT=9100
ADMIN_PORT=9200
GATEWAY_PORT=4000
MS01_PORT=8081
MS02_PORT=8082
MS03_PORT=8083
MS04_PORT=8084
DYNAMODB_PORT=8000
